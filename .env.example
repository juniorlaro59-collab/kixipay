# KixiPay Environment Variables
# Copy this file to .env and fill in the values

# Dev: deixar vazio para usar proxy Vite (sem CORS). Prod: definir URL completa.
VITE_API_URL=

# URL do backend Kixikila (usada pelo proxy Vite em dev)
VITE_API_PROXY=https://kixikilaapp.onrender.com

VITE_USE_MOCK=false
